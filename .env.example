# EZ Trucking — environment variable names. NO VALUES, EVER.
#
# This file is tracked. Everything below is a NAME and a PLACEHOLDER. If you find
# yourself pasting a real value here, stop: `.env` is gitignored and is where real
# values go. CI (gitleaks, `check:env`) will reject a real value in this file.
#
# Secret names are also declared in `agents/secrets.ts` (SECRET_NAMES). A skill may
# only read a name its own manifest lists (CLAUDE.md rule 41); reading anything
# else trips the kill switch.

# ---------------------------------------------------------------------------
# PUBLIC — inlined into the browser bundle by Vite. Not secret.
# Tenant isolation rests on RLS, not on hiding these.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SERVER-SIDE TARGETS — classified by packages/config/env.ts (SPEC 1B).
# Each is classified independently and they must all agree; an unrecognised shape
# throws UnknownEnvironment rather than defaulting to scratch.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Connection strings carry the database password inline, which is why they are on
# the secret list even though a URL looks harmless.
SUPABASE_DB_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_POOLER_URL=postgres://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# KEYS — secret. Never in this file, never in code, never in a prompt, never in a
# log (rule 6). The service-role key bypasses RLS entirely.
# ---------------------------------------------------------------------------
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
SCRATCH_SERVICE_ROLE=
SUPABASE_SERVICE_ROLE=

# Model provider. Owned by agents/models.ts; never handed to a skill.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# BILLING — names only, and deliberately unset everywhere (EZ-BUILD-01 Slice 11).
#
# There is nothing to charge for yet and no price to charge: D-2 is Andrew's to
# WRITE, not merely to approve (BUILD_DEFAULTS section 2). Until then the mock
# adapter answers, and it sells nothing.
#
# Setting these changes NOTHING on its own. `selectBillingAdapter()` returns the
# mock whether or not a key is present, because a secret appearing in an
# environment must not by itself start charging customers. A real adapter lands
# with a price and a reviewed key, in its own ticket.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PROCESS CLASSIFICATION — not secret, but load-bearing (SPEC 1B).
# ---------------------------------------------------------------------------
# agent | app | edge. UNSET MEANS AGENT — the web app and Edge Functions must opt
# out explicitly. An agent process may never reach a prod-classified target.
EZ_PROCESS_KIND=

# Optional assertion: if set and it disagrees with what the targets resolve to,
# startup fails. Cheap insurance against a half-swapped .env.
EZ_ENV_CLAIM=

# Set ONLY in the CI/Vercel secret store, never in a file: lets agents/models.ts
# load a hosted-API key outside prod.
# ALLOW_HOSTED_IN_NONPROD=
